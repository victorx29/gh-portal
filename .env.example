PORT=3000
DATABASE_URL=postgres://gh:gh@db:5432/gh
SESSION_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
COOKIE_SECURE=false          # true en producción detrás de HTTPS (EasyPanel)
N8N_WEBHOOK_URL=             # webhook de n8n que recibe los eventos (vacío = no se envían)
N8N_API_KEY=                 # clave compartida con n8n
PORTAL_URL=                  # dirección pública del portal, sin barra final (enlaces en los eventos)
N8N_WEBHOOK_LECTURA_URL=     # (0.9.4) webhook del flujo «Lectura de CV» (OCR y datos de contacto); vacío = la carga masiva no lee los CV
N8N_WEBHOOK_IA_URL=          # (0.9) webhook del flujo «Análisis de CV con IA»; vacío = los eventos cv.* van a N8N_WEBHOOK_URL
PORTAL_URL_INTERNA=          # (0.9) cómo llega n8n al portal por la red interna de EasyPanel (ej. http://<proyecto>_<servicio>:3000); vacío = PORTAL_URL
# PERMITIR_LIMPIEZA=si          # solo mientras se limpian datos de prueba (npm run limpiar); quitarla después
