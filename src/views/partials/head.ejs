<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= typeof title !== 'undefined' ? title + ' · Gestión Humana' : 'Gestión Humana' %></title><link rel="stylesheet" href="/css/app.css"><script src="/js/app.js" defer></script></head><body<%- user ? ' class="in"' : '' %>>
<% if (user) { const gh = user.roles.some(r => r.rol === 'gh' || r.rol === 'superadmin'); const items = [['/pipeline', 'pipeline', 'Pipeline', 'pipeline']].concat(gh ? [['/config', 'config', 'Configuración', 'config']] : []); %>
<div class="app"><aside class="side" id="side" aria-label="Menú principal">
  <div class="brand t">GH<i></i></div>
  <div class="who t"><b><%= user.nombre %></b><br><small><%= user.rolesTxt %></small></div>
  <% items.forEach(i => { %><a class="nav<%= nav === i[1] ? ' on' : '' %>" href="<%= i[0] %>" title="<%= i[2] %>"<%- nav === i[1] ? ' aria-current="page"' : '' %>><%- ic(i[3]) %><span class="t"><%= i[2] %></span></a><% }) %>
  <div class="sp"></div>
  <button class="nav" type="button" id="th" title="Cambiar tema"><%- ic('luna') %><span class="t">Tema claro u oscuro</span></button>
  <button class="nav" type="button" id="cl" title="Colapsar menú"><%- ic('colapsar') %><span class="t">Colapsar menú</span></button>
  <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="nav" type="submit" title="Cerrar sesión"><%- ic('salir') %><span class="t">Cerrar sesión</span></button></form>
</aside><main>
<% } else { %><main class="solo"><% } %>
<% if (flash) { %><div class="flash <%= flash.type %> toast" role="<%= flash.type === 'err' ? 'alert' : 'status' %>"><span><%= flash.msg %></span><button type="button" class="x" data-toast-x aria-label="Cerrar aviso">×</button></div><% } %>
