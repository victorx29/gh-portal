<%# Datos de la ficha del empleado (0.9.3). cat: catálogos; v: valores actuales; k: prefijo de los id; exigir: obligatorios marcados %>
<% const rq = exigir ? ' required' : '', mk = exigir ? ' *' : '', val = x => x == null ? '' : x, op = (lista, sel) => lista.map(o => `<option${o === sel ? ' selected' : ''}>${o.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c])}</option>`).join(''); %>
<fieldset><legend>Datos personales (solo Gestión Humana)</legend><div class="g2">
<div><label for="<%= k %>-fn">Fecha de nacimiento<%= mk %></label><input id="<%= k %>-fn" name="fecha_nacimiento" type="date" value="<%= val(v.fecha_nacimiento) %>"<%= rq %>></div>
<div><label for="<%= k %>-sx">Sexo<%= mk %></label><select id="<%= k %>-sx" name="sexo"<%= rq %>><option value="">Elige</option><%- op(cat.sexos.concat(v.sexo && !cat.sexos.includes(v.sexo) ? [v.sexo] : []), v.sexo) %></select></div>
<div><label for="<%= k %>-hi">Hijos<%= mk %></label><input id="<%= k %>-hi" name="hijos" type="number" min="0" max="30" value="<%= val(v.hijos) %>"<%= rq %>></div>
<div><label for="<%= k %>-na">Nivel académico<%= mk %></label><select id="<%= k %>-na" name="nivel_academico"<%= rq %>><option value="">Elige</option><%- op(cat.grados.concat(v.nivel_academico && !cat.grados.includes(v.nivel_academico) ? [v.nivel_academico] : []), v.nivel_academico) %></select></div>
<div><label for="<%= k %>-ti">Título<%= mk %></label><input id="<%= k %>-ti" name="titulo" value="<%= val(v.titulo) %>"<%= rq %> placeholder="Ingeniero en Informática"></div></div></fieldset>
<fieldset><legend>Datos laborales</legend><div class="g2">
<div><label for="<%= k %>-ub">Ubicación (sede)<%= mk %></label><select id="<%= k %>-ub" name="ubicacion"<%= rq %>><option value="">Elige</option><%- op(cat.ubicaciones.concat(v.ubicacion && !cat.ubicaciones.includes(v.ubicacion) ? [v.ubicacion] : []), v.ubicacion) %></select></div>
<div><label for="<%= k %>-te">Tipo de empleado<%= mk %></label><select id="<%= k %>-te" name="tipo_empleado"<%= rq %>><option value="">Elige</option><% cat.tipos.forEach(t => { %><option data-fin="<%= t.requiere_fin ? 1 : 0 %>"<%= t.nombre === v.tipo_empleado ? ' selected' : '' %>><%= t.nombre %></option><% }) %><% if (v.tipo_empleado && !cat.tipos.some(t => t.nombre === v.tipo_empleado)) { %><option selected><%= v.tipo_empleado %></option><% } %></select></div>
<div><label for="<%= k %>-ff">Fin de contrato <small class="mu">(obligatorio si el tipo lo pide)</small></label><input id="<%= k %>-ff" name="fecha_fin_contrato" type="date" value="<%= val(v.fecha_fin_contrato) %>"></div></div></fieldset>
