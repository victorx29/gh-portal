<tr><td><label class="sr" for="cte">Elaborado por</label><input id="cte" placeholder="Nombre y cargo"></td><td><label class="sr" for="ctr">Revisado por</label><input id="ctr" placeholder="Nombre y cargo"></td><td><label class="sr" for="cta">Aprobado por</label><input id="cta" placeholder="Nombre y cargo"></td></tr>
