<%- include('partials/head') %>
<div class="top"><div><%- include('partials/crumb', { aqui: 'Carga masiva de cargos' }) %><h1>Carga masiva de cargos</h1><p class="sub">Perfiles y Cargos desde Excel. Nada se aplica hasta que revises la vista previa.</p></div></div>
<%- include('partials/config_nav') %>
<ol class="pasos">
  <li><b>Descarga el Excel.</b> Trae los perfiles actuales con su versión activa. <a class="btn" href="/perfiles/plantilla.xlsx"><%- ic('bajar') %>Descargar Excel</a></li>
  <li><b>Edítalo.</b> Código vacío = perfil nuevo. Cambiar el contenido crea una versión nueva. Lo que no esté en el archivo no se toca.</li>
  <li><b>Súbelo y revisa</b> los errores y las advertencias antes de aplicar.</li></ol>
<form method="post" action="/perfiles/carga?_csrf=<%= csrf %>" enctype="multipart/form-data" class="row form-max"><label class="sr" for="ar">Archivo .xlsx</label>
<input id="ar" type="file" name="archivo" accept=".xlsx" required style="max-width:420px"><button class="btn p"><%- ic('subir') %>Revisar archivo</button></form>
<% if (res) { const s = res.resumen; %><%- include('partials/carga_preview', { res: { ...res, kpis: [['Perfiles nuevos', s.nuevos], ['Con cambios', s.cambian], ['Sin cambios', Math.max(0, s.sinCambio)], ['Advertencias', res.avisos.length]] }, aplicar: '/perfiles/carga/aplicar', descartar: '/perfiles/carga' }) %><% } %>
<%- include('partials/foot') %>
