<%- include('partials/head') %>
<% const fd = s => !s ? '—' : s instanceof Date ? s.toLocaleDateString('es-VE') : String(s).slice(0, 10).split('-').reverse().join('/'); %>
<div class="top"><div><h1>Empleados</h1><p class="sub">Base de empleados del grupo. La ficha completa (con datos personales) es solo de Gestión Humana y cada consulta queda registrada.</p></div>
<div class="row"><a class="btn" href="/organigrama"><%- ic('estructura') %>Organigrama</a><a class="btn p" href="/empleados/importar"><%- ic('subir') %>Importar Listado de Activos</a></div></div>
<% if (porReg) { %><p class="flash" role="status"><b><%= porReg %> plaza<%= porReg > 1 ? 's' : '' %> por regularizar.</b> Las creó la carga inicial para personas sin plaza autorizada: no cuentan en el HC hasta que GH las regularice. <a href="/config/plantilla/por-regularizar">Revisarlas</a></p><% } %>
<form method="get" action="/empleados" class="filtros">
  <div><label for="eq">Buscar</label><input id="eq" name="q" value="<%= f.q %>" placeholder="Nombre o cédula"></div>
  <div><label for="ee">Empresa</label><select id="ee" name="empresa"><option value="">Todas</option><% empresas.forEach(e => { %><option value="<%= e.id %>"<%= String(e.id) === String(f.empresa) ? ' selected' : '' %>><%= e.nombre %></option><% }) %></select></div>
  <div><label for="es">Estado</label><select id="es" name="estado"><% [['activo', 'Activos'], ['egresado', 'Egresados'], ['todos', 'Todos']].forEach(([v, t]) => { %><option value="<%= v %>"<%= v === f.estado ? ' selected' : '' %>><%= t %></option><% }) %></select></div>
  <div class="end"><button class="btn">Aplicar</button><% if (f.q || f.empresa || f.estado !== 'activo') { %> <a class="btn" href="/empleados">Limpiar</a><% } %></div>
</form>
<p class="sub"><%= es.length %> persona<%= es.length === 1 ? '' : 's' %></p>
<% if (!es.length) { %><div class="empty">No hay empleados con esos filtros.<% if (!f.q && !f.empresa) { %> Importa el Listado de Activos para empezar.<% } %></div>
<% } else { %><div class="tw"><table class="mid"><tr><th>Nombre</th><th>Cargo</th><th>Unidad</th><th>Empresa</th><th>Plaza</th><th>Ingreso</th><th>Estado</th></tr>
<% es.forEach(x => { %><tr<%- x.estado === 'activo' ? '' : ' class="off"' %>><td><a href="/empleados/<%= x.id %>" data-modal><b><%= x.nombres %></b></a></td><td><%= x.cargo %></td><td><%= x.unidad || '—' %></td><td><%= x.empresa || '—' %></td>
<td class="cod"><%= x.plaza || '—' %><% if (x.por_regularizar) { %> <span class="chip w" title="No cuenta en el HC hasta que GH la regularice">⚑</span><% } %></td><td><%= fd(x.fecha_ingreso) %></td><td><span class="chip<%= x.estado === 'activo' ? '' : ' w' %>"><%= { activo: 'Activo', egresado: 'Egresado', movido: 'Movido', no_ingreso: 'No ingresó', por_ingresar: 'Por ingresar', corregida: 'Corregida' }[x.estado] || x.estado %></span></td></tr><% }) %></table></div><% } %>
<%- include('partials/foot') %>
