<%- include('partials/head') %>
<% const fd = s => !s ? '—' : s instanceof Date ? s.toLocaleDateString('es-VE') : String(s).slice(0, 10).split('-').reverse().join('/'); %>
<div class="top"><div><%- include('partials/crumb', { aqui: 'Plazas por regularizar' }) %><h1>Plazas por regularizar</h1>
<p class="sub">Las creó la carga inicial del Listado para personas que no tenían una plaza autorizada. No cuentan en el HC ni admiten reemplazo o ingreso hasta que GH las regularice: el perfil debe tener su descripción y debe constar quién autorizó la plaza.</p></div></div>
<%- include('partials/config_nav') %>
<% if (!zs.length) { %><div class="empty">No hay plazas por regularizar.</div><% } else { %><p class="sub"><%= zs.length %> plaza<%= zs.length > 1 ? 's' : '' %></p>
<form method="post" action="/config/plazas/regularizar-varias" data-confirm="Se regularizan las plazas marcadas con el mismo soporte. Las que no cumplan (perfil sin descripción) se informan y quedan igual." data-ok="Regularizar"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="tw"><table class="mid"><tr><th><label class="chk"><input type="checkbox" data-marcar-todos="ids"><span class="sr">Marcar todas</span></label></th><th>Plaza</th><th>Cargo</th><th>Unidad</th><th>Empresa</th><th>Ocupante</th><th>Desde</th><th></th></tr>
<% zs.forEach(z => { %><tr><td><label class="chk"><input type="checkbox" name="ids" value="<%= z.id %>"><span class="sr">Marcar <%= z.codigo %></span></label></td><td class="cod"><%= z.codigo %></td><td><%= z.perfil %> <small class="mu"><%= z.perfil_codigo %><%= z.modalidad !== 'nomina' ? ' · ' + z.modalidad : '' %></small></td><td><%= z.unidad %></td><td><%= z.empresa || 'Por definir' %></td><td><% if (z.ocupante) { %><a href="/empleados/<%= z.ocupante_id %>" data-modal><%= z.ocupante %></a><% } else { %>—<% } %></td><td><%= fd(z.desde) %></td>
<td class="acts"><a class="btn" href="/config/plazas/<%= z.id %>/regularizar" data-modal>Regularizar</a><% if (z.ocupante_rel) { %> <a class="btn" href="/empleados/relacion/<%= z.ocupante_rel %>/reubicar" data-modal>Reubicar</a><% } %></td></tr><% }) %></table></div>
<div class="g2"><div><label for="rv-a">Quién autorizó las plazas marcadas y soporte</label><input id="rv-a" name="autorizado" required placeholder="Directora de GH: pasantes y becarios 2026, correo del 23-11-2026"></div></div>
<p class="act"><button class="btn p">Regularizar las marcadas</button></p></form><% } %>
<%- include('partials/foot') %>
