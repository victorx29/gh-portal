<%- include('partials/head') %><div class="top"><div><%- include('partials/crumb', { aqui: 'Usuarios y roles' }) %><h1>Usuarios y roles</h1>
<p class="sub">Gerente y director se asignan por <b>unidad</b>: alcanzan a esa unidad y a todas las que dependen de ella. La asignación por empresa sigue funcionando mientras terminas de cargar la estructura. GH siempre es global.</p></div></div>
<%- include('partials/config_nav') %>
<div class="tw"><table class="mid"><tr><th>Usuario</th><th>Roles</th><th></th></tr>
<% us.forEach(u => { %><tr<%- u.activo ? '' : ' class="off"' %>><td><b><%= u.nombre %></b><% if (!u.activo) { %> <span class="chip r">inactivo</span><% } %><br><small class="mu"><%= u.email %></small></td>
<td><% if (!u.roles.length) { %><span class="mu">Sin rol</span><% } %><% u.roles.forEach(r => { %><form method="post" action="/usuarios/rol/<%= r.id %>/borrar" class="inl"><input type="hidden" name="_csrf" value="<%= csrf %>"><span class="chip<%= r.rol === 'director' && r.unidad && !r.aprueba ? ' w' : '' %>" title="<%= r.rol === 'director' && r.unidad && !r.aprueba ? 'La unidad no está marcada como «aprueba»' : '' %>"><%= r.rol %> · <%= r.unidad || r.empresa || 'todas' %><button class="x" title="Retirar rol" aria-label="Retirar rol <%= r.rol %> de <%= u.nombre %>">×</button></span></form><% }) %></td>
<td class="acts"><a class="btn" href="/usuarios/<%= u.id %>/rol" data-modal><%- ic('mas') %>Rol</a>
<form method="post" action="/usuarios/<%= u.id %>/activo" class="inl"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn"><%= u.activo ? 'Desactivar' : 'Activar' %></button></form><% if (isSuper) { %><a class="btn d" href="/usuarios/<%= u.id %>/eliminar" data-modal>Eliminar</a><% } %></td></tr><% }) %></table></div>
<h2 class="h2s">Crear usuario</h2><form method="post" action="/usuarios" class="g2 form-max"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div><label for="un">Nombre</label><input id="un" name="nombre" required></div><div><label for="ue">Correo</label><input id="ue" name="email" type="email" required></div>
<div><label for="up">Clave temporal (mínimo 10 caracteres)</label><input id="up" name="password" type="password" minlength="10" required autocomplete="new-password"></div><div class="end"><button class="btn p">Crear usuario</button></div></form>
<%- include('partials/foot') %>
