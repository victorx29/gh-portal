<div class="mh"><div><h2>Asignar rol</h2><p class="sub"><%= u.nombre %> · <%= u.email %></p></div><button type="button" class="btn" data-close>Cerrar</button></div>
<form method="post" action="/usuarios/<%= u.id %>/rol"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label for="rr">Rol</label><select id="rr" name="rol"><% ROLES.forEach(r => { %><option value="<%= r %>"><%= { gerente: 'Gerente (solicita)', director: 'Director (aprueba)', presidencia: 'Presidencia (aprueba cargos nuevos)', gh: 'Gestión Humana', superadmin: 'Superadmin' }[r] %></option><% }) %></select>
<div data-when="rol=gerente|director"><label for="ru">Unidad (recomendado)</label><select id="ru" name="unidad_id" data-buscar><option value="">— Por empresa, sin unidad —</option><% unidades.forEach(o => { %><option value="<%= o.id %>" data-a="<%= o.anc.join(',') %>" data-t="<%= o.codigo %>"><%= o.escalera %></option><% }) %></select>
<p class="sub">El rol alcanza a la unidad elegida y a todas las que dependen de ella por línea sólida. Un director solo recibe requisiciones si su unidad está marcada como «aprueba».</p></div>
<div data-when="rol=gerente|director|presidencia"><label for="re">Empresa (solo si no eliges unidad)</label><select id="re" name="empresa_id"><option value="">Todas</option><% empresas.forEach(e => { %><option value="<%= e.id %>"><%= e.siglas ? e.siglas + ' · ' : '' %><%= e.nombre %></option><% }) %></select></div>
<p class="act"><button type="button" class="btn" data-close>Cancelar</button> <button class="btn p">Asignar rol</button></p></form>
