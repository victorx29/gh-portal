<% const act = p.versiones.find(v => v.id === p.version_activa_id), hid = '<input type="hidden" name="_csrf" value="' + csrf + '">';
   const actual = { general: p.general, emps: p.alcance.filter(a => a.empresa_id).map(a => a.empresa_id), unis: p.alcance.filter(a => a.unidad_id).map(a => a.unidad_id) }; %>
<div class="mh"><div><h2><%= p.nombre %></h2><p class="sub"><%= p.codigo %><%= p.nivel ? ' · Nivel ' + p.nivel : '' %><%= p.nivel_j ? ' · ' + p.nivel_j : '' %> · <%= p.general ? 'General' : (p.alcance.map(a => a.empresa || a.unidad).join(', ') || 'sin alcance: nadie lo ve') %>
<% if (!p.activo) { %> · <span class="chip r">inactivo</span><% } %></p></div><button type="button" class="btn" data-close>Cerrar</button></div>

<section class="blk"><h3><%- ic('cargo') %> Versión activa: <%= act ? codigoV(p.codigo, act.version) : 'ninguna' %></h3>
<% if (act) { %><p class="sub">Creada por <%= act.autor %> el <%= new Date(act.creado_en).toLocaleDateString('es-VE') %> · usada en <%= act.n_req %> requisición<%= act.n_req === 1 ? '' : 'es' %></p><%- include('partials/perfil_ver', { c: act.contenido || {}, RESP }) %>
<p class="act"><a class="btn" href="/perfiles/<%= p.id %>/descripcion" target="_blank" rel="noopener">Imprimir descripción de cargo</a></p><% } %></section>

<details class="blk"><summary>Editar contenido (crea la versión <%= codigoV(p.codigo, (p.versiones[0] ? p.versiones[0].version : 0) + 1) %>)</summary>
<form method="post" action="/perfiles/<%= p.id %>/version"><%- hid %>
<%- include('partials/perfil_contenido', { k: 'v' + p.id, cont: act ? act.contenido : null }) %>
<label class="chk"><input type="checkbox" name="activar" checked>Activarla al guardar (las requisiciones ya creadas conservan su versión)</label>
<p class="act"><button class="btn p">Guardar nueva versión</button></p></form></details>

<details class="blk"><summary>Versiones (<%= p.versiones.length %>)</summary>
<% p.versiones.forEach(v => { %><details><summary><%= codigoV(p.codigo, v.version) %><%= v.id === p.version_activa_id ? ' · activa' : '' %> <small class="mu">· <%= v.autor %> · <%= new Date(v.creado_en).toLocaleDateString('es-VE') %> · <%= v.n_req %> req.</small></summary>
<%- include('partials/perfil_ver', { c: v.contenido || {}, RESP }) %>
<% const k = ctl.get(v.id) || {}, fd = x => x ? String(x).slice(0, 10).split('-').reverse().join('/') : '—'; %>
<div class="ctl"><b>Control documental</b> · actualizado <%= fd(k.fecha_actualizacion) %> · revisado por <%= k.revisado_por || '—' %> (<%= fd(k.fecha_revision) %>) · aprobado por <%= k.aprobado_por || '—' %> (<%= fd(k.fecha_aprobacion) %>)<%= k.origen && k.origen !== 'manual' ? ' · ' + k.origen : '' %></div>
<details><summary>Registrar revisión y aprobación</summary><form method="post" action="/perfiles/<%= p.id %>/versiones/<%= v.id %>/control"><%- hid %><div class="g2">
<div><label for="fa-<%= v.id %>">Fecha de actualización del documento</label><input id="fa-<%= v.id %>" type="date" name="fecha_actualizacion" value="<%= k.fecha_actualizacion ? String(k.fecha_actualizacion).slice(0, 10) : '' %>"></div><div></div>
<div><label for="rp-<%= v.id %>">Revisado por</label><input id="rp-<%= v.id %>" name="revisado_por" value="<%= k.revisado_por || '' %>"></div>
<div><label for="fr-<%= v.id %>">Fecha de revisión</label><input id="fr-<%= v.id %>" type="date" name="fecha_revision" value="<%= k.fecha_revision ? String(k.fecha_revision).slice(0, 10) : '' %>"></div>
<div><label for="ap-<%= v.id %>">Aprobado por</label><input id="ap-<%= v.id %>" name="aprobado_por" value="<%= k.aprobado_por || '' %>"></div>
<div><label for="fp-<%= v.id %>">Fecha de aprobación</label><input id="fp-<%= v.id %>" type="date" name="fecha_aprobacion" value="<%= k.fecha_aprobacion ? String(k.fecha_aprobacion).slice(0, 10) : '' %>"></div></div>
<p class="act"><button class="btn">Guardar control</button> <a class="btn" href="/perfiles/<%= p.id %>/descripcion?v=<%= v.version %>" target="_blank" rel="noopener">Imprimir esta versión</a></p></form></details>
<% if (v.id !== p.version_activa_id) { %><form method="post" action="/perfiles/<%= p.id %>/versiones/<%= v.id %>/activar"><%- hid %><p class="act"><button class="btn">Activar esta versión</button></p></form><% } %></details><% }) %></details>

<details class="blk"><summary>Datos y alcance</summary>
<form method="post" action="/perfiles/<%= p.id %>/editar"><%- hid %><div class="g2">
<div><label for="pd-n">Nombre del cargo</label><input id="pd-n" name="nombre" value="<%= p.nombre %>" required></div>
<div><label for="pd-l">Nivel</label><select id="pd-l" name="nivel"><option value="">—</option><% NIVELES.concat(p.nivel && !NIVELES.includes(p.nivel) ? [p.nivel] : []).forEach(n => { %><option<%= n === p.nivel ? ' selected' : '' %>><%= n %></option><% }) %></select></div><div><label for="pf-nj<%= typeof p !== 'undefined' ? p.id : '' %>">Nivel jerárquico (fila en el organigrama)</label><select id="pf-nj<%= typeof p !== 'undefined' ? p.id : '' %>" name="nivel_jerarquico_id"><option value="">Sin nivel</option><% niveles.forEach(n => { %><option value="<%= n.id %>"<%= typeof p !== 'undefined' && p.nivel_jerarquico_id === n.id ? ' selected' : '' %>><%= n.nombre %></option><% }) %></select></div></div>
<%- include('partials/alcance', { actual, uid: p.id }) %>
<p class="act"><button class="btn p">Guardar datos y alcance</button></p></form></details>

<form method="post" action="/perfiles/<%= p.id %>/activo" <%- p.activo ? 'data-confirm="El perfil deja de ofrecerse en el formulario de requisición." data-ok="Desactivar" data-peligro' : '' %> class="blk"><%- hid %><p class="sub"><%= p.activo ? 'Desactivarlo lo quita del formulario de requisición. Las requisiciones existentes no cambian.' : 'Está inactivo: no aparece en el formulario de requisición.' %></p>
<button class="btn<%= p.activo ? ' d' : '' %>"><%= p.activo ? 'Desactivar perfil' : 'Activar perfil' %></button></form>
