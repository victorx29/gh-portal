<%- include('partials/head') %>
<form class="panel login" method="post" action="/login"><h1>Gestión Humana</h1><p class="sub">Ingresa con tu cuenta</p>
<input type="hidden" name="_csrf" value="<%= csrf %>">
<% if (error) { %><div class="flash err" role="alert"><%= error %></div><% } %>
<label for="email">Correo</label><input id="email" name="email" type="email" autocomplete="username" required autofocus>
<label for="password">Clave</label><input id="password" name="password" type="password" autocomplete="current-password" required>
<p><button class="btn p" type="submit">Ingresar</button></p></form>
<%- include('partials/foot') %>
