<div class="mh"><div><h2><%= x.cargo %></h2><p class="sub"><%= x.codigo %> · <%= x.empresa %> · <span class="chip"><%= x.estado.replace('pend_', 'pendiente ').replace(/_/g, ' ') %></span><% if (x.sin_aprobador) { %> <span class="chip w">sin aprobador</span><% } %></p></div><button type="button" class="btn" data-close>Cerrar</button></div>
<% const f = d => d ? new Date(d).toLocaleDateString('es-VE') : '—'; %>
<% if (x.estado === 'pend_director') { %><div class="flash<%= x.sin_aprobador ? ' err' : '' %>" role="status"><%- ic('aprueba') %> <span><% if (x.sin_aprobador) { %><b>Retenida: nadie puede aprobarla todavía.</b> <%= x.aprob_nombre ? '«' + x.aprob_nombre + '» aprueba pero no tiene director asignado.' : 'Ninguna unidad de su cadena aprueba y su empresa no tiene director.' %> Gestión Humana fue notificada; avanzará sola cuando se complete la estructura.<% } else { %>Pendiente de aprobación en <b><%= x.aprob_nombre || 'la dirección de la empresa' %></b>.<% } %></span></div><% } %>
<table class="kv"><tr><th>Unidad</th><td><%= x.unidad || '—' %><% if (x.unidad_codigo) { %> <small class="mu"><%= x.unidad_codigo %></small><% } %></td></tr><tr><th>Tipo</th><td><%= x.tipo === 'nuevo' ? 'Cargo nuevo' : 'Reemplazo' %><% if (x.sustituye_a) { %> · sustituye a <%= x.sustituye_a %><% } %></td></tr>
<tr><th>Profesión u oficio</th><td><%= x.profesion || '—' %></td></tr><tr><th>Grado de instrucción</th><td><%= x.grado || '—' %></td></tr><tr><th>Experiencia</th><td style="white-space:pre-line"><%= x.experiencia || '—' %></td></tr>
<tr><th>Contratación</th><td><%= x.contratacion %><% if (x.contratacion === 'Temporal') { %> · del <%= f(x.vigencia_desde) %> al <%= f(x.vigencia_hasta) %><% } %></td></tr>
<tr><th>Plaza</th><td><% if (x.plaza_codigo) { %><%= x.plaza_codigo %><% if (gh) { %> · <a href="/config/plantilla?buscar=<%= encodeURIComponent(x.unidad || '') %>">ver en plantilla</a><% } %><% } else if (x.tipo === 'nuevo') { %><span class="mu">Se crea en la plantilla al aprobarse</span><% } else { %><span class="mu">— (requisición anterior a la plantilla)</span><% } %></td></tr><tr><th>Fecha requerida</th><td><%= f(x.fecha_requerida) %></td></tr><tr><th>Perfil</th><td>versión <%= x.perfil_v %> · <a href="/perfiles/<%= x.perfil_id %>/vista" data-modal2>ver</a></td></tr>
<tr><th>Equipos</th><td><%= x.equipos.map(e => e.nombre + (e.requiere_linea ? ' (con línea)' : '')).join(', ') || '—' %><% if (x.equipos_otros) { %><br>Otros: <%= x.equipos_otros %><% } %></td></tr>
<tr><th>Accesos</th><td><%= x.accesos.map(a => a.nombre + (a.nivel ? ' — ' + a.nivel : '')).join('; ') || '—' %></td></tr><tr><th>Correo corporativo</th><td><%= x.correo_corporativo ? 'Sí' : 'No' %></td></tr>
<tr><th>Solicitante</th><td><%= x.solicitante %></td></tr><tr><th>Justificación</th><td><%= x.justificacion || '—' %></td></tr><% if (x.motivo_cierre) { %><tr><th>Motivo de cierre</th><td><%= x.motivo_cierre %></td></tr><% } %></table>
<% if (a.decidir) { %><form method="post" action="/requisiciones/<%= x.id %>/decidir" class="blk"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label for="cm">Comentario (obligatorio al devolver o rechazar)</label><textarea id="cm" name="comentario" rows="2"></textarea>
<p class="act"><button class="btn p" name="d" value="aprobada">Aprobar</button> <button class="btn" name="d" value="devuelta">Devolver</button> <button class="btn d" name="d" value="rechazada">Rechazar</button></p></form><% } %>
<% if (a.etapa) { %><%- include('partials/registro', { action: '/requisiciones/' + x.id + '/registro', reg: a.registro, et: a.etapa }) %><% } %>
<% if (a.mover && a.bloqueos.length) { %><div class="flash err" role="alert"><b>No puede avanzar todavía</b><ul><% a.bloqueos.forEach(b => { %><li><%= b %></li><% }) %></ul></div><% } %>
<p class="act"><% if (a.editar) { %><a class="btn" href="/requisiciones/<%= x.id %>/editar" data-modal>Editar</a> <% } %>
<% if (a.enviar) { %><form method="post" action="/requisiciones/<%= x.id %>/enviar" class="inl"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn p">Enviar a aprobación</button></form><% } %>
<% if (a.mover) { %><form method="post" action="/requisiciones/<%= x.id %>/mover" class="inl"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn p">Pasar a <%= a.siguiente %></button></form><% } %>
<% if (a.seleccion) { %><a class="btn p" href="/requisiciones/<%= x.id %>/seleccion">Abrir tablero de selección</a><% } %></p>
<% if (a.cancelar) { %><form method="post" action="/requisiciones/<%= x.id %>/cancelar" class="blk"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="mo">Cancelar requisición (motivo obligatorio)</label><input id="mo" name="motivo"><p class="act"><button class="btn d">Cancelar requisición</button></p></form><% } %>
<% if (a.eliminar || a.anular) { %><details><summary>Eliminar o anular el borrador</summary>
<% if (a.eliminar) { %><form method="post" action="/requisiciones/<%= x.id %>/eliminar"><input type="hidden" name="_csrf" value="<%= csrf %>"><p class="sub">Nunca se envió: se elimina por completo.</p><button class="btn d">Eliminar borrador</button></form><% } %>
<% if (a.anular) { %><form method="post" action="/requisiciones/<%= x.id %>/anular"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="an">Anular (se conserva el historial; motivo obligatorio)</label><input id="an" name="motivo"><p class="act"><button class="btn d">Anular</button></p></form><% } %></details><% } %>
<% if (aps.length) { const DEC = { aprobada: 'Aprobó', devuelta: 'Devolvió', rechazada: 'Rechazó', automatica: 'Aprobación automática' }; %><details><summary>Aprobaciones (<%= aps.length %>)</summary>
<% aps.forEach(p => { const f = p.estructura || {}; %><div class="log"><b><%= DEC[p.decision] || p.decision %></b> — <%= p.autor %> · <%= p.paso === 'presidencia' ? 'Presidencia' : 'Director' %><br><small><%= new Date(p.fecha).toLocaleString('es-VE') %></small>
<% if (p.comentario) { %><br><span style="white-space:pre-line"><%= p.comentario %></span><% } %>
<% if ((f.cadena || []).length) { %><br><small class="mu">Estructura en ese momento: <%= f.cadena.map(c => c.nombre + (f.aprobadora && c.id === f.aprobadora.id ? ' (aprobó)' : '')).join(' › ') %></small><% } else if (f.regla === 'empresa') { %><br><small class="mu">Aprobada por la regla de transición: director de la empresa.</small><% } %></div><% }) %></details><% } %>
<% if (gh && !['rechazada', 'anulada', 'cancelado'].includes(x.estado)) { %><details><summary>Cambiar empresa (Gestión Humana)</summary>
<form method="post" action="/requisiciones/<%= x.id %>/empresa"><input type="hidden" name="_csrf" value="<%= csrf %>">
<p class="sub">Cambia la empresa de la requisición<%= x.plaza_codigo ? ' y de su plaza ' + x.plaza_codigo : '' %>. Queda en la línea de tiempo y se avisa a n8n. La foto de la aprobación no cambia.</p>
<div class="g2"><div><label for="ce-e">Nueva empresa</label><select id="ce-e" name="empresa_id" required><% empresas.filter(e => e.id !== x.empresa_id).forEach(e => { %><option value="<%= e.id %>"><%= e.siglas ? e.siglas + ' · ' : '' %><%= e.nombre %></option><% }) %></select></div>
<div><label for="ce-m">Motivo</label><input id="ce-m" name="motivo" required placeholder="Decisión de Gestión Humana: nómina CIM"></div></div>
<% if (confirmar) { %><p class="flash err" role="alert"><%- ic('alerta') %> <span>Fue aprobada por alguien con alcance de empresa (Presidencia o director de la empresa). El cambio <b>no repite</b> la aprobación.</span></p>
<label class="chk"><input type="checkbox" name="confirmo" required>Entiendo y quiero cambiarla igual</label><% } %>
<p class="act"><button class="btn">Cambiar empresa</button></p></form></details><% } %>
<details open><summary>Comentarios (<%= com.length %>)</summary>
<% com.forEach(c => { %><div class="cmt<%= c.ambito === 'gh' ? ' gh' : '' %>"><b><%= c.autor %></b><% if (c.ambito === 'gh') { %> <span class="chip w">nota interna GH</span><% } %> <small><%= new Date(c.creado_en).toLocaleString('es-VE') %></small><br><span style="white-space:pre-line"><%= c.texto %></span></div><% }) %>
<% if (!com.length) { %><p class="sub">Sin comentarios todavía.</p><% } %>
<form method="post" action="/requisiciones/<%= x.id %>/comentarios"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="ct">Nuevo comentario (queda en la traza y no se puede editar)</label><textarea id="ct" name="texto" rows="2" required></textarea>
<% if (user.roles.some(r => r.rol === 'gh' || r.rol === 'superadmin')) { %><label for="ca">Visible para</label><select id="ca" name="ambito"><option value="proceso">Todos los involucrados</option><option value="gh">Solo Gestión Humana (nota interna)</option></select><% } %>
<p class="act"><button class="btn">Comentar</button></p></form></details>
<details><summary>Adjuntos (<%= adj.length %>)</summary>
<% adj.forEach(f => { %><div class="cmt"><a href="/adjuntos/<%= f.id %>"><%= f.nombre_original %></a> <small>· <%= f.autor %> · <%= Math.max(1, Math.round(f.tamano / 1024)) %> KB · <%= new Date(f.subido_en).toLocaleDateString('es-VE') %></small></div><% }) %>
<% if (!adj.length) { %><p class="sub">Sin archivos.</p><% } %>
<form method="post" action="/requisiciones/<%= x.id %>/adjuntos?_csrf=<%= csrf %>" enctype="multipart/form-data"><label for="ar">Adjuntar (PDF, imágenes, Word, Excel o texto; máximo 10 MB c/u)</label>
<input id="ar" type="file" name="archivos" multiple accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx,.txt" required><p class="act"><button class="btn">Subir</button></p></form></details>
<details><summary>Línea de tiempo (<%= linea.length %>)</summary>
<% linea.forEach(i => { %><div class="log"><b><%= i.titulo %></b> — <%= i.autor || 'Sistema' %><br><small><%= new Date(i.fecha).toLocaleString('es-VE') %></small><% if (i.detalle) { %><br><span style="white-space:pre-line"><%= i.detalle %></span><% } %></div><% }) %></details>
