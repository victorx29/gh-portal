<div class="mh"><h2>Nuevo candidato</h2><button type="button" class="btn" data-close>Cerrar</button></div>
<form method="post" action="/requisiciones/<%= reqId %>/candidatos"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="g2">
<div><label for="cn">Nombre completo</label><input id="cn" name="nombre" required></div><div><label for="cc">Cédula</label><input id="cc" name="cedula" required inputmode="numeric" placeholder="V-12345678" aria-describedby="cc-a"><p class="sub" id="cc-a">Si ya postuló antes, se usa la misma ficha.</p></div>
<div><label for="ce">Correo</label><input id="ce" name="email" type="email"></div><div><label for="ct">Teléfono</label><input id="ct" name="telefono"></div></div>
<% if (defsCand.length) { %><fieldset><legend>Datos adicionales</legend><%- include('partials/campos_form', { defs: defsCand, vals: {}, k: 'nc' }) %></fieldset><% } %>
<p class="sub">El CV y su análisis con IA se cargan en la ficha del candidato, después de agregarlo.</p>
<p class="act"><button type="button" class="btn" data-close>Cancelar</button> <button class="btn p">Agregar</button></p></form>
