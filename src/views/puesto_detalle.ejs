<% const p = d.p, k = d.k, hid = '<input type="hidden" name="_csrf" value="' + csrf + '">', fd = s => s ? String(s).slice(0, 10).split('-').reverse().join('/') : '—';
   const CH = { vigente: '', congelada: ' w', proyectada: '', cerrada: ' r' }; const abiertas = d.plazas.filter(z => z.estado !== 'cerrada'), cerradas = d.plazas.filter(z => z.estado === 'cerrada'); %>
<div class="mh"><div><h2><%= p.perfil %></h2><p class="sub"><%= p.perfil_codigo %> · <%= p.unidad %> (<%= p.unidad_codigo %>)<%= p.jefe ? ' · ★ Puesto jefe de la unidad' : '' %></p></div><button type="button" class="btn" data-close>Cerrar</button></div>
<div class="kpi"><div><small>HC de nómina</small><strong><%= k.hc %></strong></div><div><small>Congeladas</small><strong><%= k.cong %></strong></div><div><small>Proyectadas</small><strong><%= k.proy %></strong></div><div><small>Externas</small><strong><%= k.externas %></strong></div></div>
<section class="blk"><h3><%- ic('estructura') %> Reporta a</h3>
<p><% if (d.reporta) { %><b><%= d.reporta.perfil %></b> · <%= d.reporta.unidad %> <small class="mu">(<%= p.regla === 'excepcion' ? 'excepción registrada' : 'regla por defecto: jefe directo' %>)</small><% } else { %><span class="mu">Nadie: no hay un puesto jefe por encima en la estructura.</span><% } %></p>
<details><summary>Cambiar jefe o línea de reporte</summary><form method="post" action="/config/plantilla/puesto/<%= p.id %>/editar"><%- hid %>
<label class="chk"><input type="checkbox" name="jefe"<%= p.jefe ? ' checked' : '' %>>Es el puesto jefe de la unidad</label>
<label for="pd-r">Reporta a</label><select id="pd-r" name="reporta_a" data-buscar><option value="">Regla por defecto: el jefe de la unidad</option><% puestos.filter(o => o.id !== p.id).forEach(o => { %><option value="<%= o.id %>" data-a="<%= o.id %>"<%= p.reporta_a === o.id ? ' selected' : '' %>><%= o.etiqueta %></option><% }) %></select>
<p class="act"><button class="btn p">Guardar</button></p></form></details></section>
<section class="blk"><h3><%- ic('plantilla') %> Plazas (<%= abiertas.length %>)</h3>
<% if (!abiertas.length) { %><p class="mu">Este puesto no tiene plazas abiertas.</p><% } else { %><div class="tw"><table class="mid"><tr><th>Plaza</th><th>Empresa</th><th>Modalidad</th><th>Estado</th><th>Desde</th><th></th></tr>
<% abiertas.forEach(z => { %><tr><td class="cod"><%= z.codigo %></td><td title="<%= z.empresa || 'Se fija al aprobar la requisición o al ingresar la persona' %>"><%= z.empresa_id ? (z.siglas || z.empresa) : 'Por definir' %></td><td><%= MODALIDADES[z.modalidad] %></td><td><span class="chip<%= CH[z.estado] %>"><%= z.estado === 'congelada' ? '❄ ' : z.estado === 'proyectada' ? '⏳ ' : '' %><%= z.estado[0].toUpperCase() + z.estado.slice(1) %></span><% if (z.req) { %> <span class="chip w" title="Requisición abierta">↻ <%= z.req.codigo %></span><% } %></td><td><%= fd(z.desde) %></td>
<td class="acts"><details class="inl-d"><summary class="btn">Acciones</summary><div class="pop">
<form method="post" action="/config/plazas/<%= z.id %>/congelar"><%- hid %><input type="hidden" name="on" value="<%= z.congelada ? '0' : '1' %>"><label class="sr" for="m1-<%= z.id %>">Motivo</label><input id="m1-<%= z.id %>" name="motivo" placeholder="Motivo" required><button class="btn"><%= z.congelada ? 'Descongelar' : 'Congelar' %></button></form>
<% if (!z.req) { %><form method="post" action="/config/plazas/<%= z.id %>/empresa" data-confirm="¿Cambiar la empresa de nómina de esta plaza? Queda registrado con su motivo." data-ok="Cambiar empresa"><%- hid %><label class="sr" for="e3-<%= z.id %>">Empresa</label><select id="e3-<%= z.id %>" name="empresa_id"><option value="">Por definir</option><% empresas.forEach(e => { %><option value="<%= e.id %>"<%= z.empresa_id === e.id ? ' selected' : '' %>><%= e.siglas || e.mostrar %></option><% }) %></select><input name="motivo" placeholder="Motivo" required aria-label="Motivo del cambio de empresa"><button class="btn">Cambiar empresa</button></form><% } else { %><p class="sub">La empresa se cambia desde la requisición <%= z.req.codigo %>.</p><% } %>
<form method="post" action="/config/plazas/<%= z.id %>/cerrar" data-confirm="Cerrar la plaza es definitivo: queda en el historial y no se puede reabrir." data-ok="Cerrar plaza" data-peligro><%- hid %><label class="sr" for="m2-<%= z.id %>">Motivo del cierre</label><input id="m2-<%= z.id %>" name="motivo" placeholder="Motivo del cierre" required><button class="btn d">Cerrar plaza</button></form>
</div></details></td></tr><% }) %></table></div><% } %>
<details<%= typeof agregar !== 'undefined' && agregar ? ' open' : '' %>><summary><%- ic('mas') %> Agregar plazas</summary><form method="post" action="/config/plantilla/puesto/<%= p.id %>/plazas"><%- hid %><%- include('partials/plazas_form', { k: 'd' + p.id, requerido: true }) %>
<p class="act"><button class="btn p">Agregar plazas</button></p></form></details>
<% if (cerradas.length) { %><details><summary>Plazas cerradas (<%= cerradas.length %>)</summary><div class="tw"><table><tr><th>Plaza</th><th>Empresa</th><th>Vigencia</th><th>Motivo</th></tr>
<% cerradas.forEach(z => { %><tr><td class="cod"><%= z.codigo %></td><td><%= z.empresa_id ? (z.siglas || z.empresa) : 'Por definir' %></td><td><%= fd(z.desde) %> → <%= fd(z.hasta) %></td><td><%= z.motivo_cierre || '—' %><br><small class="mu"><%= z.cerrado_por_nombre || '' %></small></td></tr><% }) %></table></div></details><% } %></section>
<details class="blk"><summary><%- ic('estructura') %> Mover a otra unidad</summary>
<form method="post" action="/config/plantilla/puesto/<%= p.id %>/mover" data-confirm="El puesto se mueve con todas sus plazas a la unidad elegida. Queda en el historial; las requisiciones ya creadas no cambian." data-ok="Mover puesto"><%- hid %>
<p class="sub">Para corregir un puesto que quedó en la unidad equivocada, sin cerrar ni recrear sus plazas.<%= p.reporta_a ? ' Su excepción de reporte se quitará: pasará a reportar al jefe de la unidad nueva.' : '' %></p>
<label for="mv-u">Unidad destino</label><select id="mv-u" name="unidad_id" required data-buscar><option value="">Selecciona la unidad</option><% unidades.filter(o => o.id !== p.unidad_id).forEach(o => { %><option value="<%= o.id %>" data-a="<%= o.anc.join(',') %>" data-t="<%= o.codigo %>"><%= o.escalera %></option><% }) %></select>
<label for="mv-m">Motivo</label><input id="mv-m" name="motivo" required placeholder="Corrección: los analistas pertenecen a la Jefatura">
<p class="act"><button class="btn p">Mover puesto</button></p></form></details>
<details class="blk"><summary><%- ic('reloj') %> Historial (<%= d.historial.length %>)</summary>
<% d.historial.forEach(h => { const x = h.detalle || {}; %><div class="log"><b><%= { crear: 'Creó el puesto', editar: 'Editó el puesto', desactivar: 'Desactivó el puesto', 'plazas.alta': 'Agregó ' + (x.cantidad || '') + ' plaza(s)', congelar: 'Congeló ' + (x.codigo || ''), descongelar: 'Descongeló ' + (x.codigo || ''), cerrar: 'Cerró ' + (x.codigo || ''), empresa: 'Cambió la empresa de ' + (x.codigo || ''), mover: 'Movió el puesto de «' + (x.de || '') + '» a «' + (x.a || '') + '»' }[h.accion] || h.accion %></b> — <%= h.autor || 'Sistema' %><br><small><%= new Date(h.fecha || h.creado_en).toLocaleString('es-VE') %><%= x.motivo ? ' · ' + x.motivo : '' %><%= x.origen ? ' · ' + x.origen : '' %></small></div><% }) %></details>
<form method="post" action="/config/plantilla/puesto/<%= p.id %>/desactivar" data-confirm="El puesto dejará de usarse en la plantilla y el diagrama." data-ok="Desactivar puesto" data-peligro class="blk"><%- hid %><p class="sub">Para desactivar el puesto, primero cierra sus plazas abiertas.</p><button class="btn d">Desactivar puesto</button></form>
