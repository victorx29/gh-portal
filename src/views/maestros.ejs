<%- include('partials/head') %><div class="top"><div><%- include('partials/crumb', { aqui: titulo }) %><h1><%= titulo %></h1><p class="sub"><%= m === 'niveles' ? 'Ordena los niveles de arriba abajo con ↑ ↓. Cada perfil elige su nivel y el organigrama de cargos dibuja una fila por nivel. Debajo del último van becarios, pasantes y aprendices.' : 'Lo desactivado deja de ofrecerse en los formularios, pero se conserva donde ya se usó.' %></p></div></div>
<%- include('partials/config_nav') %>
<div class="tw"><table class="mid"><tr><th>Nombre</th><% if (m === 'equipos') { %><th>Pide línea telefónica</th><% } %><% if (m === 'tipos') { %><th>Nivel (orden)</th><% } %><% if (m === 'niveles') { %><th>Fila en el organigrama</th><% } %><th>Estado</th><th></th></tr>
<% filas.forEach(x => { %><tr<%- x.activo ? '' : ' class="off"' %>><td><%= x.nombre %></td><% if (m === 'equipos') { %><td><%= x.requiere_linea ? 'Sí' : 'No' %></td><% } %><% if (m === 'tipos') { %><td><%= x.nivel %></td><% } %><% if (m === 'niveles') { const i = filas.indexOf(x); %><td><span class="cod"><%= i + 1 %></span>
<form method="post" action="/config/maestros/niveles/<%= x.id %>/mover" class="inl"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="dir" value="up"><button class="btn" aria-label="Subir <%= x.nombre %>"<%= i === 0 ? ' disabled' : '' %>>↑</button></form>
<form method="post" action="/config/maestros/niveles/<%= x.id %>/mover" class="inl"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="dir" value="down"><button class="btn" aria-label="Bajar <%= x.nombre %>"<%= i === filas.length - 1 ? ' disabled' : '' %>>↓</button></form></td><% } %><td><%= x.activo ? 'Activo' : 'Inactivo' %></td>
<td class="acts"><form method="post" action="/config/maestros/<%= m %>/<%= x.id %>/activo"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn"><%= x.activo ? 'Desactivar' : 'Activar' %></button></form></td></tr><% }) %>
<% if (!filas.length) { %><tr><td colspan="4" class="empty">Aún no hay elementos. Agrega el primero abajo.</td></tr><% } %></table></div>
<form method="post" action="/config/maestros/<%= m %>" class="row addrow"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="sr" for="n-<%= m %>">Nuevo elemento</label><input id="n-<%= m %>" name="nombre" placeholder="Nuevo elemento" required style="max-width:320px">
<% if (m === 'equipos') { %><label class="chk"><input type="checkbox" name="requiere_linea">Pide línea telefónica</label><% } %>
<% if (m === 'tipos') { %><label class="sr" for="nv">Nivel</label><input id="nv" name="nivel" type="number" min="1" max="999" value="50" style="max-width:110px" title="Nivel: ordena la lista (menor = más arriba)"><% } %><button class="btn p">Agregar</button></form>
<%- include('partials/foot') %>
